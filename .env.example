VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Preferred browser-safe key from Supabase Project Settings → API.
VITE_SUPABASE_PUB_KEY=YOUR_PUBLISHABLE_KEY
# Legacy projects may use this instead of VITE_SUPABASE_PUB_KEY.
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# The app returns to the current origin; this value is documentation only.
VITE_SUPABASE_CALLBACK_URL=YOUR_CALLBACK_URL
# Configure the Google client secret in Supabase Auth, never in the frontend.
GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Backend adapter for the SPA:
# - omit or leave blank: `pnpm dev` uses local SQLite + mock Google; production uses Supabase when configured
# - local: force in-browser SQLite + mock Google accounts (Alice / Bob / Carol)
# - supabase: force the real Supabase project even in Vite dev
# VITE_BACKEND=local
